# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Vercel holds the production copies (Project → Settings → Environment Variables).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_TIMEZONE=Asia/Manila

# Neon (one production database). Pooled for the app, direct for migrations and scripts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)
HASH_PEPPER=
CRON_SECRET=

# Owner account seed — used ONLY by `npm run admin:seed` (local CLI). Never put these in Vercel.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=moekoworks-official
CLOUDINARY_PRESET_IMAGES=moekoworks_images_signed
CLOUDINARY_PRESET_VIDEOS=moekoworks_videos_signed
